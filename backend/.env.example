# ========== DeepSeek（OpenAI 兼容）==========
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ========== 阿里云 Qwen / DashScope ==========
# 默认使用 DashScope 原生 API；若 QWEN_BASE_URL 含 compatible-mode 则走 OpenAI 兼容格式
QWEN_API_KEY=sk-your-dashscope-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen-plus

# ========== Cursor-pro（须为 OpenAI 兼容代理，非 api.cursor.com）==========
# 例：本地 Cursor Bridge http://127.0.0.1:8765/v1
CURSOR_API_KEY=your-cursor-api-key
CURSOR_BASE_URL=http://127.0.0.1:8765/v1
CURSOR_MODEL=composer-2

# ---------- 兼容旧配置（未设置 DEEPSEEK_API_KEY 时自动使用）----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_DEFAULT_MODEL=deepseek-v4-flash
OPENAI_CHAT_MAX_TOKENS=4096

# SQLite
DATABASE_URL=sqlite+aiosqlite:///./aipm.db
# 相对路径会自动解析为 aipm-backend/aipm.db 的绝对路径

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fernet key for encrypting custom model API keys
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
