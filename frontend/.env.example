# ===========================================
# AIPM Bench 前端环境变量示例
# 复制为 .env 或 .env.local 后按需修改
# ===========================================

# 是否使用本地 Mock 数据（不连接后端）
# true  = 纯前端 mock（无需启动 aipm-backend）
# false = 连接真实 FastAPI 后端（需先启动 aipm-backend）
VITE_USE_MOCK_API=false

# API 基路径（开发时通过 vite.config.ts 代理到 http://127.0.0.1:8000）
VITE_API_BASE=/api

# 是否在控制台打印 API 请求（调试用）
# VITE_DEBUG_API=true
